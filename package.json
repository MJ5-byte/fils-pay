{
  "name": "filspay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @filspay/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p db --noEmit && tsc -p scripts --noEmit",
    "test": "npm run test --workspaces --if-present && tsx --test scripts/*.test.ts",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.11.6",
    "typescript": "^5.6.3",
    "tsx": "^4.19.1"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
