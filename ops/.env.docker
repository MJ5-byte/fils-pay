# Local docker-compose environment — sandbox/dev only. Do not point this
# compose file at production infrastructure.
#
# NODE_ENV=production so local behaviour matches the hosted box (secure
# cookies, https-only webhook URLs). If cookies don't stick on plain http
# localhost, that's why. — MK
# This file is tracked in git, so it holds placeholders only. Each host copies
# ops/.env.docker.example over it and fills in real values; never commit them.
NODE_ENV=production
PORT=3000

# Shared secret the sandbox acquirer signs its async callbacks with.
# Required when NODE_ENV=production. Set it on the host, never here.
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Redis for the api's dashboard read cache. Compose sets REDIS_URL to
# redis://redis:6379 in the api's own environment, which wins over this
# file, so leave it empty here. Set it only to run the api outside compose,
# for example redis://127.0.0.1:6379. Empty means no cache.
REDIS_URL=
