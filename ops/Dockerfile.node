# Node image for the API, migrate/seed jobs and the reporting worker.
# Build context is the repository root (see ops/docker-compose.yml).
# NOTE: written during the FP-300 audit and not yet exercised in CI.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages ./packages
COPY apps ./apps
COPY db ./db
COPY scripts ./scripts
RUN npm ci
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "run", "start", "--workspace", "@filspay/api"]
