# Template for ops/.env.docker, the file compose loads into every service
# via env_file. Copy it to ops/.env.docker and fill in real values on the
# host. Placeholder names only here; never commit a real secret.

# Run the services in production mode on the hosted box: secure cookies,
# https-only webhook URLs, no dev OTP exposure, no built-in dev webhook key.
NODE_ENV=production
PORT=3000

# Bearer token apps/api presents to apps/settlement's internal HTTP server.
# Required when NODE_ENV=production. Pick a long random string, same value
# for both services.
SETTLEMENT_INTERNAL_TOKEN=

# Shared secret the sandbox acquirer signs its async callbacks with.
# Required when NODE_ENV=production.
ACQUIRER_CALLBACK_SIGNING_SECRET=

# Reject any acquirer callback that is missing or has a bad signature.
# Keep this on in production.
ACQUIRER_CALLBACK_REQUIRE_SIGNATURE=true

# Base64 of 32 random bytes. apps/api uses it to encrypt webhook secrets at
# rest; required in every environment. Generate with:
#   openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call apps/api. Empty in
# production, so set this to the hosted web and admin origins once they are
# served, or their requests are blocked by CORS. Example:
#   CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=
