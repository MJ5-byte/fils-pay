# Image for the `web` service in ops/docker-compose.yml: builds apps/web and
# apps/admin with Vite, then serves both from nginx with ops/nginx.conf,
# which also proxies apps/api on the same origin.

# Build stage. Same base and install as Dockerfile.node's deps stage, so the
# npm ci layer is shared from the build cache. The API base URLs are empty,
# so both apps call the api on their own origin (/v1/...). apps/web is built
# with base /web/ so its assets don't collide with apps/admin's /assets/.
FROM node:20.18-bookworm AS build
WORKDIR /app
COPY . .
RUN npm ci
RUN VITE_API_BASE_URL= npm run build -w @filspay/web -- --base=/web/ \
 && VITE_ADMIN_API_BASE_URL= VITE_WEB_BASE_URL=/dashboard npm run build -w @filspay/admin

# Runtime stage. 1.28 has `resolve` on upstream servers, which ops/nginx.conf
# uses to follow a restarted api container.
FROM nginx:1.28-alpine AS runtime
COPY ops/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/web
COPY --from=build /app/apps/admin/dist /usr/share/nginx/admin
